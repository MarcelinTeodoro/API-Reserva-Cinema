# Banco SQLite usado pelo Prisma
DATABASE_URL="file:./dev.db"

# Porta da API (padrao: 6999)
PORT=6999

# URL do Grupo C (pagamentos). Obrigatoria para iniciar a API.
GRUPO_C_URL="https://url-do-grupo-c/reservas"

# Atraso opcional para demonstrar assentos PENDENTE no dashboard.
# Use 0 para desabilitar.
DEMO_PENDING_DELAY_MS=0
