// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Assento {
  id            String    @id @default(cuid())
  salaId        String
  numero        String    // Ex: "H10", "A01"
  status        String    @default("LIVRE") // LIVRE | BLOQUEADO | RESERVADO
  bloqueadoEm   DateTime?
  expiradoEm    DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  reservas      Reserva[] @relation("AssentoReservas")

  @@unique([salaId, numero])
}

model Reserva {
  id            String    @id @default(cuid())
  usuarioId     String
  filmeId       String
  salaId        String
  horario       DateTime
  status        String    @default("PENDENTE") // PENDENTE | CONFIRMADA | CANCELADA
  assentoId     String
  criadoEm      DateTime  @default(now())
  expiradoEm    DateTime
  atualizadoEm  DateTime  @updatedAt

  assento       Assento   @relation("AssentoReservas", fields: [assentoId], references: [id], onDelete: Cascade)

  @@unique([assentoId, status])
}
